[
  {
    "finding_id": "demo-path-traversal",
    "relative_source_root": "examples/demo-target",
    "image": "alpine:3.20",
    "command": [
      "sh",
      "-c",
      "if [ -n \"$EDSA_NEGATIVE_CONTROL\" ]; then echo EDSA_CONTROL_CLEAN; else test -r /workspace/README.md && echo EDSA_REPRODUCED; fi"
    ],
    "environment": {},
    "sandbox_policy": {
      "run_as_user": "65532:65532",
      "cpu_limit": "1.0",
      "memory_limit": "512m",
      "pids_limit": 128,
      "timeout_seconds": 60,
      "cleanup_timeout_seconds": 15,
      "maximum_output_bytes_per_stream": 1048576,
      "tmpfs_size": "64m",
      "temporary_filesystem_executable": false
    },
    "oracle": {
      "kind": "stdout_pattern",
      "expected": "EDSA_REPRODUCED"
    },
    "negative_control": {
      "kind": "stdout_pattern",
      "expected": "EDSA_CONTROL_CLEAN"
    }
  }
]
