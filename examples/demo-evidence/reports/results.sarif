{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/demo-target/README.md"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "Committed evidence records a deterministic attack/control distinction."
          },
          "partialFingerprints": {
            "edsaFindingId": "demo-path-traversal"
          },
          "properties": {
            "edsa.confidence": "high",
            "edsa.confirmed": true,
            "edsa.evidenceDigests": [],
            "edsa.verdict": "confirmed"
          },
          "ruleId": "CWE-22"
        }
      ],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/",
          "name": "Evidence-Driven Security Agent",
          "semanticVersion": "0.1.0"
        }
      }
    }
  ],
  "version": "2.1.0"
}